{
  "name": "skybreak",
  "private": true,
  "version": "1.0.0",
  "description": "SKYBREAK: Flying Roadster — a neon-city arcade racer built with React, TypeScript and Three.js. Runs on desktop and mobile, deploys to Vercel, and also ships as one standalone HTML file.",
  "license": "MIT",
  "author": "Abdul Wasay Siddiqui",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "single": "node scripts/build-single.mjs",
    "icons": "node scripts/make-icons.mjs",
    "release": "npm run build && npm run single"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
